---
// Soft email gate, aligned with the Nature's Solutions gate in Explora:
// same Supabase `signup` function, fields, Kajabi route (Free eBook form via Zapier) and copy.
// The full case study is always in the HTML, so search engines and AI agents read everything
// (the open tier in the Explora V2.0 strategy). People get GATE.free case studies, then a
// one-time sign-up unlocks every case study for good on that device.
import { GATE } from "../lib/config.js";
const { slug, total } = Astro.props;
---
<div class="gate" data-gate data-slug={slug} hidden>
  <div class="gate-card">
    <p class="gate-over">Free to join</p>
    <h2 class="gate-title">Keep exploring nature's solutions</h2>
    <p class="gate-text" data-new-only>You've read {GATE.free} case studies. Join free to open all {total}, with every breakdown and design prompt, and we'll send you <b>A Field Guide to Biomimicry</b> eBook with emails picked for your field.</p>
    <p class="gate-text" data-returning-only hidden>Welcome back. Enter the email you joined with and every case study opens on this device.</p>

    <form class="gate-form" data-gate-form novalidate>
      <label class="gate-field" data-new-only><span>Your name</span><input name="name" autocomplete="name" maxlength="120" /></label>
      <label class="gate-field"><span>Email</span><input name="email" type="email" autocomplete="email" maxlength="200" /></label>
      <label class="gate-field" data-new-only><span>Your field</span>
        <select name="interest">
          <option value="">Choose one</option>
          {GATE.interests.map(([k, v]) => <option value={k}>{v}</option>)}
        </select>
      </label>
      <input class="gate-hp" name="website" type="text" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <label class="gate-tick" data-new-only><input name="consent" type="checkbox" /><span>Yes, email me the eBook and biomimicry news from Learn Biomimicry. Unsubscribe any time. <a href="https://www.learnbiomimicry.com/privacy-policy">Privacy policy</a></span></label>
      <p class="gate-error" data-gate-error role="alert" hidden></p>
      <button type="submit" class="gate-btn" data-gate-btn>Unlock every case study</button>
    </form>

    <button type="button" class="gate-switch" data-gate-switch>Already joined? Unlock with your email</button>
  </div>
</div>

<script>
  import { GATE } from "../lib/config.js";

  const gate = document.querySelector("[data-gate]");
  const SEEN = "lb_seen_cases";
  const ACCESS = "lb_access";
  const hasCookie = () => /(?:^|;\s*)lb_access=1/.test(document.cookie);

  const store = {
    get(k) { try { return localStorage.getItem(k); } catch { return null; } },
    set(k, v) { try { localStorage.setItem(k, v); } catch {} },
  };
  const hasAccess = () => hasCookie() || store.get(ACCESS) === "1";
  const markAccess = () => {
    store.set(ACCESS, "1");
    // Long-lived server cookie (Safari keeps it), shared across *.learnbiomimicry.com.
    fetch(GATE.cookieUrl, { credentials: "same-origin" }).catch(() => {});
    // Fallback if the server cookie can't land (e.g. a preview domain without the function).
    if (!hasCookie()) document.cookie = `${ACCESS}=1; Path=/; Max-Age=63072000; SameSite=Lax; Secure`;
  };

  const main = document.querySelector(".cs .main");
  const gated = document.querySelector("[data-gated]");
  const story = document.querySelector("[data-story]");
  let seen = [];
  try { seen = JSON.parse(store.get(SEEN) || "[]"); } catch {}

  function lock() {
    main.classList.add("is-locked");
    gate.hidden = false;
    gated?.setAttribute("inert", "");
    gated?.setAttribute("aria-hidden", "true");
  }
  function unlock() {
    markAccess();
    main.classList.remove("is-locked");
    gate.hidden = true;
    gated?.removeAttribute("inert");
    gated?.removeAttribute("aria-hidden");
    story?.classList.add("is-open");
    document.querySelector("[data-read-more]")?.setAttribute("hidden", "");
    gated?.querySelectorAll(".reveal").forEach((el) => el.classList.add("is-in"));
  }

  // Links in Kajabi emails can carry ?access=lb: unlock this device without the form.
  const url = new URL(location.href);
  if (url.searchParams.get("access") === "lb") {
    markAccess();
    url.searchParams.delete("access");
    history.replaceState(null, "", url.pathname + url.search + url.hash);
  }

  if (gate && main && !hasAccess()) {
    const slug = gate.dataset.slug;
    if (!seen.includes(slug)) {
      if (seen.length < GATE.free) { seen.push(slug); store.set(SEEN, JSON.stringify(seen)); }
      else lock();
    }
  }

  // Form
  const form = gate?.querySelector("[data-gate-form]");
  const err = gate?.querySelector("[data-gate-error]");
  const btn = gate?.querySelector("[data-gate-btn]");
  const switchBtn = gate?.querySelector("[data-gate-switch]");
  const LABEL = { new: "Unlock every case study", back: "Unlock" };
  let returning = false;

  switchBtn?.addEventListener("click", () => {
    returning = !returning;
    gate.querySelectorAll("[data-new-only]").forEach((el) => (el.hidden = returning));
    gate.querySelectorAll("[data-returning-only]").forEach((el) => (el.hidden = !returning));
    btn.textContent = returning ? LABEL.back : LABEL.new;
    switchBtn.textContent = returning ? "New here? Join free" : "Already joined? Unlock with your email";
    err.hidden = true;
  });

  form?.addEventListener("submit", async (ev) => {
    ev.preventDefault();
    const f = form.elements;
    const say = (msg) => { err.textContent = msg; err.hidden = false; };
    const email = f.email.value.trim();
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) return say("Please check your email address.");

    // Returning visitor on a new device: no password and no lookup, just let them in.
    if (returning) { unlock(); return; }

    const body = {
      name: f.name.value.trim(), email, interest: f.interest.value, consent: f.consent.checked,
      website: f.website.value, source: GATE.source, viewed: seen.concat(gate.dataset.slug),
    };
    if (!body.name) return say("Please add your name.");
    if (!body.interest) return say("Please pick your field.");
    if (!body.consent) return say("Please tick the box so we can send the eBook.");

    err.hidden = true;
    btn.disabled = true;
    btn.textContent = "Unlocking...";
    try {
      const res = await fetch(GATE.signupUrl, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(body) });
      const data = await res.json().catch(() => ({}));
      if (!res.ok || !data.ok) throw new Error(data.error || "");
      unlock();
    } catch (e) {
      btn.disabled = false;
      btn.textContent = LABEL.new;
      say(String(e.message).startsWith("Please") ? e.message : "We couldn't reach the server. Please try again in a moment.");
    }
  });
</script>

<style>
  .gate { position: relative; z-index: 2; margin: -8px 0 40px; }
  .gate-card { background: #fff; border: 1px solid rgba(10,69,100,0.14); border-radius: 10px; padding: 32px 32px 24px; box-shadow: 0 18px 50px -20px rgba(10,69,100,0.35); max-width: 560px; }
  .gate-over { font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--lb-web); }
  .gate-title { font-family: var(--font-head); font-weight: 900; font-size: 26px; line-height: 1.15; color: var(--lb-deep); margin: 8px 0 10px; }
  .gate-text { font-size: 15px; line-height: 1.6; color: rgba(35,31,32,0.78); margin-bottom: 20px; }
  .gate-text b { font-weight: 600; color: var(--lb-deep); }
  .gate-form { display: grid; gap: 12px; }
  .gate-field { display: grid; gap: 6px; font-size: 12px; color: rgba(35,31,32,0.7); }
  .gate-field input, .gate-field select { font: inherit; font-size: 16px; padding: 11px 12px; border: 1px solid rgba(35,31,32,0.2); border-radius: 6px; background: #fff; color: var(--lb-charcoal); width: 100%; }
  .gate-field input:focus, .gate-field select:focus { outline: 2px solid var(--lb-web); outline-offset: 1px; border-color: transparent; }
  .gate-tick { display: flex; gap: 10px; align-items: flex-start; font-size: 13px; line-height: 1.5; color: rgba(35,31,32,0.7); margin-top: 2px; cursor: pointer; }
  .gate-tick input { margin-top: 3px; flex: none; }
  .gate-tick a { color: inherit; }
  .gate-hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
  .gate-error { font-size: 13px; color: var(--lb-berry); }
  .gate-btn { margin-top: 4px; border: 0; border-radius: 999px; background: var(--lb-web); color: #fff; font-weight: 600; font-size: 15px; padding: 13px 22px; cursor: pointer; transition: background .2s; }
  .gate-btn:hover { background: var(--lb-deep); }
  .gate-btn:disabled { opacity: .7; cursor: wait; }
  .gate-switch { border: 0; background: none; padding: 0; margin-top: 14px; font-size: 13px; color: var(--lb-deep); text-decoration: underline; text-underline-offset: 3px; cursor: pointer; }
  [hidden] { display: none !important; }
  @media (max-width: 640px) { .gate-card { padding: 24px 20px 20px; } .gate-title { font-size: 22px; } }

  /* Locked state: the content is there (and readable by machines) but faded under the card. */
  :global(.cs .main.is-locked [data-story]),
  :global(.cs .main.is-locked [data-read-more]) { display: none !important; }
  :global(.cs .main.is-locked [data-gated]) { max-height: 520px; overflow: hidden; filter: blur(5px); opacity: .55; user-select: none; pointer-events: none;
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, transparent 100%); mask-image: linear-gradient(to bottom, #000 0%, transparent 100%); }
  :global(.cs .main.is-locked [data-gated] .reveal) { opacity: 1; transform: none; }
</style>
