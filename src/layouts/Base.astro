---
import { SITE, CTA, OFFERS, EVENTS, TOOLS, BETA, ANALYTICS } from "../lib/config.js";
import { win } from "../lib/timely.js";
import AnnouncementBar from "../components/AnnouncementBar.astro";
import ProgrammesBand from "../components/ProgrammesBand.astro";
const { title, description, image, jsonLd, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const fullTitle = title ? `${title} | ${SITE.name}` : `${SITE.name} | ${SITE.brand}`;
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content={image ? "summary_large_image" : "summary"} />
    <meta name="theme-color" content="#0A4564" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fira+Sans:ital,wght@1,300;1,400&family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@300;400;500;600&family=IBM+Plex+Serif:ital,wght@0,400;0,500;0,600;1,400&family=Lato:wght@300;400;700;900&display=swap" rel="stylesheet" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <script is:inline>try{if(localStorage.getItem("lb_ann_demo_closed")==="1")document.documentElement.classList.add("ann-closed")}catch(e){}</script>
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ANALYTICS.ga4}`}></script>
    <script is:inline define:vars={{ ga4: ANALYTICS.ga4 }}>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}window.gtag=gtag;gtag("js",new Date());gtag("config",ga4);</script>
  </head>
  <body>
    <AnnouncementBar />
    <header class="site-header">
      <div class="container header-row">
        <a class="wordmark" href="/" aria-label="Learn Biomimicry Examples, home">
          <img class="wm-logo" src="/images/logo.png" alt="Learn Biomimicry" width="149" height="32" /><span class="wm-tag">Examples</span>
        </a>
        <span class="beta" title="This site is new. Tell us what you think.">Beta</span>
        <nav aria-label="Main">
          <a href="/" aria-current={path === "/" ? "page" : undefined}>All examples</a>
          <a href="/level/form/" aria-current={path.startsWith("/level/form") ? "page" : undefined}>Form</a>
          <a href="/level/process/" aria-current={path.startsWith("/level/process") ? "page" : undefined}>Process</a>
          <a href="/level/system/" aria-current={path.startsWith("/level/system") ? "page" : undefined}>System</a>
          <a class="nav-cta" href={CTA.fieldGuide.href} data-track="nav-field-guide">Free Field Guide</a>
        </nav>
      </div>
    </header>
    <slot />
    <ProgrammesBand />
    <footer class="site-footer">
      <div class="container footer-grid">
        <div>
          <a class="wordmark" href={SITE.home}><img class="wm-logo" src="/images/logo-white.png" alt="Learn Biomimicry" width="121" height="32" /></a>
          <p class="footer-sub">Making biomimicry accessible, affordable and applicable.</p>
          <p class="footer-beta">This site is in beta. <a href={BETA.feedback} data-track="footer-feedback">Spot something off? Tell us</a></p>
        </div>
        <div>
          <p class="overline">Learn</p>
          <p><a href={OFFERS.shortCourses.href} data-track="footer-short-courses">Short Course Set</a></p>
          <p><a href={OFFERS.practitioner.href} data-track="footer-practitioner">Practitioner Programme</a></p>
          <p><a href={OFFERS.educator.href} data-track="footer-educator">Educator Programme</a></p>
          <p><a href={OFFERS.fieldGuide.href} data-track="footer-field-guide">Field Guide to Biomimicry</a></p>
        </div>
        <div>
          <p class="overline">Events</p>
          <p {...win(null, EVENTS.demo.end)}><a href={EVENTS.demo.register} data-track="footer-demo">{EVENTS.demo.name} ({EVENTS.demo.short}, free)</a></p>
          <p {...win(null, EVENTS.confluence.end)}><a href={EVENTS.confluence.href} data-track="footer-confluence">{EVENTS.confluence.name} ({EVENTS.confluence.when})</a></p>
          <p><a href={EVENTS.all} data-track="footer-all-events">All events</a></p>
        </div>
        <div>
          <p class="overline">Tools</p>
          <p><a href={TOOLS.explora.href} data-track="footer-explora">{TOOLS.explora.name}</a></p>
          <p><a href="/">Biomimicry Examples Database</a></p>
        </div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  /* Learn Biomimicry brand tokens, applied to Explora's layout system. */
  :root {
    --lb-deep: #0A4564;      /* brand deep blue */
    --lb-steel: #33668A;
    --lb-sky: #87BAD9;
    --lb-aqua: #A8DADC;
    --lb-web: #3498DB;       /* website action blue */
    --lb-moss: #576E3D;
    --lb-olive: #808F42;
    --lb-ochre: #B0A64C;
    --lb-amber: #F5B23A;
    --lb-plum: #4F003A;
    --lb-berry: #891236;
    --lb-rose: #CF4257;
    --lb-coral: #FF6362;
    --lb-charcoal: #231F20;

    --background: #FFFFFF;
    --foreground: #231F20;
    --surface: #F3F7FA;
    --card: #FFFFFF;
    --muted: #EEF3F6;
    --muted-foreground: #5E6A72;
    --border: #E1E8ED;
    --primary: var(--lb-deep);
    --action: var(--lb-web);
    --sidebar: var(--lb-deep);

    --level-form: var(--lb-moss);
    --level-process: var(--lb-steel);
    --level-system: var(--lb-berry);

    --font-head: "Lato", system-ui, sans-serif;
    --font-serif: "IBM Plex Serif", Georgia, serif;
    --font-sans: "IBM Plex Sans", system-ui, sans-serif;
    --font-mono: "IBM Plex Mono", ui-monospace, monospace;
    --font-sub: "Fira Sans", "IBM Plex Sans", sans-serif;

    --ease: cubic-bezier(0.4, 0, 0.2, 1);
  }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
  body { margin: 0; background: var(--background); color: var(--foreground); font-family: var(--font-sans); font-weight: 300; line-height: 1.7; -webkit-font-smoothing: antialiased; overflow-x: hidden; }
  img { max-width: 100%; display: block; }
  a { color: inherit; }
  h1, h2, h3, h4 { font-family: var(--font-head); font-weight: 900; line-height: 1.15; letter-spacing: -0.005em; margin: 0; }
  p { margin: 0; }
  button { font: inherit; cursor: pointer; }
  .container { width: 100%; max-width: 1280px; margin: 0 auto; padding: 0 16px; }
  @media (min-width: 768px) { .container { padding: 0 32px; } }
  [hidden] { display: none !important; }

  .overline { font-family: var(--font-mono); font-size: 11.5px; letter-spacing: 0.03em; color: var(--primary); font-weight: 400; }
  .subtitle, .italic-sub { font-family: var(--font-sub); font-style: italic; font-weight: 300; }
  .muted { color: var(--muted-foreground); }
  .rule { height: 1px; background: var(--border); }

  /* Header (Explora: 64px sticky, blurred) */
  .site-header { position: sticky; top: 0; z-index: 50; height: 64px; background: rgba(255,255,255,0.92); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); border-bottom: 1px solid var(--border); }
  .header-row { height: 64px; display: flex; align-items: center; justify-content: space-between; gap: 16px; }
  .wm-logo { display: block; height: 32px; width: auto; }
  .wordmark { display: flex; align-items: center; gap: 6px; text-decoration: none; color: var(--lb-charcoal); line-height: 1; white-space: nowrap; }
  .wm-tag { font-family: var(--font-mono); font-size: 11.5px; letter-spacing: 0.03em; color: var(--primary); margin-left: 8px; padding: 3px 8px; border: 1px solid rgba(10,69,100,0.25); border-radius: 999px; }
  .beta { margin-right: auto; margin-left: -6px; font-family: var(--font-mono); font-size: 11px; font-weight: 500; letter-spacing: 0.04em; color: #fff; background: var(--lb-coral); padding: 2px 8px; border-radius: 999px; line-height: 1.5; }
  nav { display: flex; align-items: center; gap: 22px; font-size: 14px; font-weight: 400; }
  nav a { text-decoration: none; color: var(--muted-foreground); transition: color .2s; }
  nav a:hover, nav a[aria-current="page"] { color: var(--primary); }
  .nav-cta { color: var(--primary) !important; border: 1.5px solid rgba(10,69,100,0.3); padding: 6px 14px; border-radius: 999px; font-weight: 500; }
  .nav-cta:hover { border-color: var(--primary); }
  @media (max-width: 860px) { nav a:not(.nav-cta) { display: none; } .wm-tag { display: none; } }

  /* Footer */
  .site-footer { background: var(--lb-deep); color: rgba(255,255,255,0.8); padding: 56px 0; margin-top: 0; font-size: 14px; }
  .footer-grid { display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr; gap: 32px; }
  .footer-beta { margin-top: 18px !important; font-size: 13px; color: rgba(255,255,255,0.65); }
  .footer-beta a { text-decoration: underline !important; text-underline-offset: 3px; }
  .site-footer p { margin: 6px 0; }
  .site-footer a { color: rgba(255,255,255,0.85); text-decoration: none; }
  .site-footer a:hover { color: #fff; text-decoration: underline; }
  .site-footer .overline { color: var(--lb-aqua); }
  .wordmark-light { color: #fff; }
  .footer-sub { font-family: var(--font-sub); font-style: italic; color: rgba(255,255,255,0.65); }
  @media (max-width: 900px) { .footer-grid { grid-template-columns: 1fr 1fr; } .footer-grid > :first-child { grid-column: 1 / -1; } }
  @media (max-width: 520px) { .footer-grid { grid-template-columns: 1fr; } }
  .ann-closed .ann { display: none !important; }

  /* Shared controls */
  .pill { display: inline-flex; align-items: center; gap: 6px; padding: 6px 16px; border-radius: 999px; border: 1px solid var(--border); background: rgba(255,255,255,0.7); color: var(--foreground); font-family: var(--font-sans); font-weight: 300; font-size: 14px; transition: all .3s var(--ease); white-space: nowrap; text-decoration: none; }
  .pill:hover { border-color: var(--action); color: var(--primary); }
  .pill.is-active { background: var(--action); border-color: var(--action); color: #fff; font-weight: 400; }
  .pill-sm { padding: 4px 12px; font-size: 12px; }
  .btn-outline { display: inline-flex; align-items: center; gap: 8px; padding: 12px 28px; border: 1px solid var(--border); border-radius: 4px; background: var(--background); color: var(--foreground); font-family: var(--font-sans); font-weight: 500; font-size: 14px; text-decoration: none; transition: all .3s var(--ease); }
  .btn-outline:hover { border-color: var(--action); color: var(--primary); }
  .link-arrow { display: inline-flex; align-items: center; gap: 6px; color: var(--primary); font-weight: 500; font-size: 14px; text-decoration: none; transition: gap .2s; }
  .link-arrow:hover { gap: 12px; }
  .grid-3 { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; align-items: start; }
  @media (max-width: 1024px) { .grid-3 { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) { .grid-3 { grid-template-columns: 1fr; } }

  .section-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; margin-bottom: 32px; }
  .section-head .overline { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; }
  .section-head h2 { font-size: clamp(1.5rem, 2.6vw, 1.9rem); }
  .section-head .lede { margin-top: 6px; font-size: 14px; color: var(--muted-foreground); max-width: 36rem; }

  @keyframes fadeUp { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: translateY(0); } }
  .fade-up { animation: fadeUp 1s var(--ease) both; }
  .fade-up-1 { animation: fadeUp 1s .15s var(--ease) both; }
  .fade-up-2 { animation: fadeUp 1s .3s var(--ease) both; }
  .fade-up-3 { animation: fadeUp 1s .45s var(--ease) both; }
  .reveal { opacity: 0; transform: translateY(18px); transition: opacity .8s var(--ease), transform .8s var(--ease); }
  .reveal.is-in { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation: none !important; transition: none !important; } .reveal { opacity: 1; transform: none; } }
</style>

<script>
  import { applyWindows } from "../lib/timely.js";
  import { BETA, GATE } from "../lib/config.js";

  // Fade sections up as they scroll into view.
  const io = new IntersectionObserver((entries) => {
    for (const e of entries) if (e.isIntersecting) { e.target.classList.add("is-in"); io.unobserve(e.target); }
  }, { rootMargin: "0px 0px -10% 0px" });
  document.querySelectorAll(".reveal").forEach((el) => io.observe(el));

  // Date-aware messages: re-check for the visitor's date (or ?now= when testing).
  applyWindows();

  // Show event times in the visitor's own time zone (South Africa time stays underneath).
  document.querySelectorAll("[data-local-time]").forEach((el) => {
    try {
      const start = new Date(el.dataset.start), end = new Date(el.dataset.end);
      const t = (d, timeZone) => d.toLocaleTimeString("en-GB", { hour: "2-digit", minute: "2-digit", timeZone });
      if (t(start) === t(start, "Africa/Johannesburg")) return; // already South Africa time
      const day = start.toLocaleDateString("en-GB", { weekday: "long", day: "numeric", month: "long" });
      const sameDay = day === start.toLocaleDateString("en-GB", { weekday: "long", day: "numeric", month: "long", timeZone: "Africa/Johannesburg" });
      el.textContent = `${sameDay ? "" : day + ", "}${t(start)} to ${t(end)} your time`;
      el.nextElementSibling?.removeAttribute("hidden");
    } catch {}
  });

  // Newsletter readers (?from=livingloop) never see the email limit on case studies.
  try {
    const [k, v] = BETA.bypassParam;
    if (new URLSearchParams(location.search).get(k) === v) {
      localStorage.setItem("lb_access", "1");
      localStorage.setItem("lb_access_via", v);
      fetch(GATE.cookieUrl, { credentials: "same-origin" }).catch(() => {});
    }
  } catch {}

  // Analytics: every link with data-track sends a cta_click event, labelled by
  // where it sits on the page (cta_location) and where it goes (cta_destination).
  document.addEventListener("click", (ev) => {
    const a = ev.target instanceof Element ? ev.target.closest("[data-track]") : null;
    if (!a || typeof window.gtag !== "function") return;
    let dest = a.getAttribute("href") || "";
    try { const u = new URL(dest, location.href); dest = u.protocol === "mailto:" ? "email" : u.hostname + u.pathname; } catch {}
    window.gtag("event", "cta_click", { cta_location: a.dataset.track, cta_destination: dest, cta_text: (a.textContent || "").trim().slice(0, 80) });
  });
</script>
