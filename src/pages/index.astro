---
// Home page, ported from Explora's ExamplesPage: hero with category pills and an
// expanding filter panel, sticky category and level bars, ranked examples that
// expand in place, a particle level banner, carousels and Example of the Day.
import Base from "../layouts/Base.astro";
import Card from "../components/Card.astro";
import Pills from "../components/Pills.astro";
import { getExamples, facetValues, facetUrl, LEVELS } from "../lib/data.js";
import { SITE, CTA } from "../lib/config.js";

const examples = await getExamples();
const bySlug = new Map(examples.map((e) => [e.slug, e]));
const industries = facetValues(examples, "industry", 1);
const countries = facetValues(examples, "country", 1);
const interests = facetValues(examples, "interest", 1);
const FIRST = 9;

const LEVEL_CONFIG = {
  Form: { img: "/images/levels/whale.jpg", color: "#576E3D", tag: "LEVEL 01", lead: "Form-based", sub: "Emulating the shapes, patterns and physical forms found in nature." },
  Process: { img: "/images/levels/mushroom.jpg", color: "#33668A", tag: "LEVEL 02", lead: "Process-based", sub: "Emulating nature's manufacturing processes and behaviours." },
  System: { img: "/images/levels/planet.png", color: "#891236", tag: "LEVEL 03", lead: "Systems-based", sub: "Learning nature's deeper principles to fit and contribute to ecosystems." },
};
const levelSets = LEVELS.map((l) => ({ level: l, items: examples.filter((e) => e.levels.includes(l)).slice(0, 6) }));

const STORIES = [
  ["velcro-burdock-hooks", "How a Walk in the Alps Gave Us Velcro"],
  ["shinkansen-kingfisher-beak", "The Bullet Train That Learned to Fly Like a Kingfisher"],
  ["sharkskin-anti-fouling", "Sharkskin: Fighting Bacteria Without Chemicals"],
  ["lotus-leaf-self-cleaning", "The Lotus Flower That Cleans Itself"],
  ["morpho-butterfly-structural-colour", "Butterfly Wings and Colour Without Dye"],
  ["spider-silk-stronger-steel", "Spider Silk: Stronger Than Steel"],
  ["eastgate-centre-termite-cooling", "Termite Mounds Reinventing Air Conditioning"],
  ["whale-fin-wind-turbines", "How Whale Fins Are Transforming Wind Energy"],
  ["gecko-dry-adhesive", "The Gecko's Dry Adhesive"],
].map(([slug, title]) => ({ e: bySlug.get(slug), title })).filter((s) => s.e && (s.e.image || s.e.image2));

// Cover photos are Explora's featured-list images (nature photography, no text).
const lists = [
  ["Top Biomimicry Examples for Architecture", "interest", "architecture", "architecture"],
  ["Top Biomimicry Examples for Product Design", "interest", "product-design", "product-design"],
  ["Top Biomimicry Examples of All Time", null, null, "all-time"],
  ["Top Biomimicry Examples for Medicine", "interest", "medical-biotechnology", "medicine"],
  ["Top Biomimicry Examples for Materials", "interest", "materials", "materials"],
  ["Top Biomimicry Examples for Engineering", "interest", "engineering", "engineering"],
].map(([label, key, slug, img]) => {
  const pool = key ? (facetValues(examples, key).find((v) => v.slug === slug)?.items ?? []) : examples;
  return pool.length ? { label, href: key ? facetUrl(key, slug) : "#best", img: `/images/lists/${img}.jpg`, count: pool.length } : null;
}).filter(Boolean);

const GUIDES = [
  { sub: "Your Guide to", title: "A Field Guide to Biomimicry", tag: "Free eBook", href: CTA.fieldGuide.href, img: "/images/guides/field-guide.jpg" },
  { sub: "Your Guide to", title: "Biomimicry Short Courses", tag: "Courses", href: CTA.courses.href, img: "/images/guides/short-courses.jpg" },
  { sub: "Your Guide to", title: "The Best Biomimicry Educator Resources", tag: "Teaching", href: "https://www.learnbiomimicry.com/blog/best-biomimicry-educator-resources", img: "/images/guides/educators.jpg" },
  { sub: "For R&D teams", title: "Your Biomimicry Opportunity Map", tag: "Explora", href: CTA.opportunityMap.href, img: "/images/guides/opportunity-map.jpg" },
];

// Example of the Day: picked at build time, then (re)picked in the browser by date.
const dayPool = examples.filter((e) => e.image && e.image2).map((e) => ({
  slug: e.slug, title: e.title, organism: e.organism, summary: e.summary, image: e.image, image2: e.image2,
  fn: e.breakdown_function ? e.breakdown_function.slice(0, 120) : null, company: e.company, location: e.location, interest: e.interest?.name || null,
}));
const today = dayPool.length ? dayPool[Math.floor(Date.now() / 86400000) % dayPool.length] : null;

const description = `Browse ${examples.length} real biomimicry examples: nature-inspired products, materials, buildings and systems. Filter by industry, country and interest, and by form, process or system.`;
const jsonLd = { "@context": "https://schema.org", "@type": "CollectionPage", name: SITE.name, description, url: SITE.url, publisher: { "@type": "Organization", name: SITE.brand, url: SITE.home } };
---
<Base title="Biomimicry Examples: discover nature's best designs" description={description} jsonLd={jsonLd}>
  <!-- HERO -->
  <section class="hero">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="container hero-inner">
      <p class="overline fade-up">The Biomimicry Examples Database</p>
      <h1 class="fade-up-1">Discover Nature's Best Designs</h1>
      <p class="hero-sub fade-up-2">Explore {examples.length} biomimicry examples and case studies, each traced from the organism to the design principle behind it.</p>
      <div class="fade-up-3">
        <Pills />
        <div class="filter-panel" data-filter-panel>
          <div class="fp-inner">
            <label class="fp-search">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
              <input type="search" data-q placeholder="Search by organism, technology or application..." aria-label="Search examples" />
            </label>
            <div class="fp-levels">
              {LEVELS.map((l) => (
                <button type="button" class="lvl" data-level={l.toLowerCase()} style={`--lvl: var(--level-${l.toLowerCase()})`}><span class="lvl-dot"></span>{l}</button>
              ))}
            </div>
            <div class="fp-selects">
              <select data-sel="industry" aria-label="Industry">
                <option value="">All industries</option>
                {industries.map((v) => <option value={v.slug}>{v.name} ({v.count})</option>)}
              </select>
              <select data-sel="country" aria-label="Country">
                <option value="">All countries</option>
                {countries.map((v) => <option value={v.slug}>{v.name} ({v.count})</option>)}
              </select>
            </div>
            <button type="button" class="fp-clear" data-clear hidden>Clear all filters</button>
          </div>
        </div>
        <p class="stats"><span><b data-count>{examples.length}</b> examples</span><span class="dot">&middot;</span><span>{interests.length} categories</span><span class="dot">&middot;</span><span class="italic-sub">Free access</span></p>
      </div>
      <div data-hero-sentinel></div>
    </div>
  </section>

  <!-- STICKY BARS -->
  <div class="sticky-bar" data-sticky-cats>
    <div class="container sticky-inner">
      <Pills compact />
      <div class="sticky-search" data-sticky-search>
        <label class="fp-search">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
          <input type="search" data-q placeholder="Search examples..." aria-label="Search examples" />
        </label>
      </div>
    </div>
  </div>
  <div class="sticky-bar" data-sticky-levels>
    <div class="container sticky-inner sticky-levels">
      <span class="overline sl-label">Level</span>
      {LEVELS.map((l, i) => <button type="button" class:list={["pill pill-sm", { "is-active": i === 0 }]} data-level-tab={l}>{l}</button>)}
    </div>
  </div>

  <main id="examples">
    <!-- BEST EXAMPLES -->
    <section class="container block" id="best">
      <div class="section-head">
        <div>
          <p class="overline"><span aria-hidden="true">&#9733;</span> <span data-best-label>Best Examples</span></p>
          <h2 data-best-title>The Best Biomimicry Examples</h2>
          <p class="lede" data-best-lede>Ranked across five criteria: biomimicry link, ease of application, wide applicability, Life's Principles and benefit to humanity.</p>
        </div>
        <button type="button" class="clear-link" data-clear hidden>Clear filters &rarr;</button>
      </div>
      <div class="grid-3" data-grid>
        {examples.map((e, i) => <Card e={e} />)}
      </div>
      <div class="empty" data-empty hidden>
        <p class="empty-title">No examples match yet</p>
        <p class="italic-sub muted">Try removing a filter</p>
      </div>
      <div class="more-row">
        <button type="button" class="btn-outline" data-more>View all <span data-more-count>{examples.length}</span> biomimicry examples <span aria-hidden="true">&#8964;</span></button>
        <button type="button" class="less-link" data-less hidden>&times; Show less</button>
      </div>
    </section>

    <div class="container"><div class="rule"></div></div>

    <!-- LEVELS -->
    <section class="block" id="levels" data-levels-section>
      <div class="container">
        <div class="section-head levels-head">
          <div>
            <p class="overline"><span aria-hidden="true">&#9776;</span> Biomimicry Levels</p>
            <h2>Form, Process and Systems Examples</h2>
            <p class="lede">Explore biomimicry at three levels of depth, from physical forms to underlying systems.</p>
          </div>
          <div class="seg" role="tablist" aria-label="Biomimicry level">
            {LEVELS.map((l, i) => <button type="button" role="tab" aria-selected={i === 0 ? "true" : "false"} class:list={["seg-btn", { "is-active": i === 0 }]} data-level-tab={l}>{l}</button>)}
          </div>
        </div>
        <div class="banner" data-banner data-config={JSON.stringify(LEVEL_CONFIG)}>
          <div class="banner-bg" aria-hidden="true"></div>
          <canvas data-particles aria-hidden="true"></canvas>
          <div class="banner-fade" aria-hidden="true"></div>
          {LEVELS.map((l, i) => (
            <div class="banner-copy" data-level-copy={l} hidden={i !== 0}>
              <span class="level-tag">{LEVEL_CONFIG[l].tag}</span>
              <h3>{LEVEL_CONFIG[l].lead}<br /><em>Biomimicry Examples</em></h3>
              <p>{LEVEL_CONFIG[l].sub}</p>
              <a class="link-arrow" href={`/level/${l.toLowerCase()}/`}>View all {l} examples <span aria-hidden="true">&rarr;</span></a>
            </div>
          ))}
        </div>
        {levelSets.map(({ level, items }, i) => (
          <div class="grid-3 level-grid" data-level-grid={level} hidden={i !== 0}>
            {items.map((e) => <Card e={e} />)}
          </div>
        ))}
        <div class="more-row">
          {LEVELS.map((l, i) => <a class="btn-outline" href={`/level/${l.toLowerCase()}/`} data-level-copy={l} hidden={i !== 0}>View all {LEVEL_CONFIG[l].lead} biomimicry <span aria-hidden="true">&rarr;</span></a>)}
        </div>
      </div>
    </section>

    <div class="container"><div class="rule"></div></div>

    <!-- STORIES -->
    {STORIES.length > 0 && (
      <section class="block reveal">
        <div class="container carousel-head">
          <p class="overline">How it happened</p>
          <h2>Stories of the Nature Inspired</h2>
        </div>
        <div class="carousel">
          {STORIES.map((s) => (
            <a class="tall-card" href={`/${s.e.slug}/`}>
              <img src={s.e.image || s.e.image2} alt={s.title} loading="lazy" decoding="async" />
              <div class="tall-shade"></div>
              <div class="tall-copy">
                <p class="tall-over">{s.e.organism}</p>
                <h3>{s.title}</h3>
                <span class="tall-link">Read story <span aria-hidden="true">&rarr;</span></span>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    <div class="container"><div class="rule"></div></div>

    <!-- FEATURED LISTS -->
    <section class="block reveal">
      <div class="container carousel-head">
        <p class="overline">Featured Lists</p>
        <h2>Featured Lists</h2>
      </div>
      <div class="carousel">
        {lists.map((l) => (
          <a class="tall-card wide" href={l.href}>
            {l.img && <img src={l.img} alt={l.label} loading="lazy" decoding="async" />}
            <div class="tall-shade"></div>
            <div class="tall-copy">
              <p class="tall-over">Featured list &middot; {l.count} examples</p>
              <h3>{l.label}</h3>
              <span class="tall-link">Explore list <span aria-hidden="true">&rarr;</span></span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- EXAMPLE OF THE DAY -->
    {today && (
      <section class="eotd reveal">
        <div class="container">
          <div class="section-head">
            <div>
              <p class="overline"><span aria-hidden="true">&#10022;</span> Today's Featured Example</p>
              <h2>Example of the Day</h2>
            </div>
          </div>
          <a class="eotd-card" href={`/${today.slug}/`} data-eotd data-pool={JSON.stringify(dayPool)}>
            <div class="eotd-imgs">
              <div><img data-eotd-img1 src={today.image} alt={`${today.title}: biological inspiration`} loading="lazy" /></div>
              <div><img data-eotd-img2 src={today.image2} alt={`${today.title}: human application`} loading="lazy" /></div>
            </div>
            <div class="eotd-body">
              <div class="eotd-tags">
                <span class="eotd-cat" data-eotd-interest hidden={!today.interest}>{today.interest}</span>
                <p class="italic-sub eotd-org" data-eotd-organism>{today.organism}</p>
              </div>
              <h3 data-eotd-title>{today.title}</h3>
              <p class="eotd-sum" data-eotd-summary>{today.summary}</p>
              <p class="eotd-meta">
                <span data-eotd-fn hidden={!today.fn}>&#9889;&#xFE0E; <span>{today.fn}</span></span>
                <span data-eotd-company hidden={!today.company}>&#9635; <span>{today.company}</span></span>
                <span data-eotd-location hidden={!today.location}>&#9673; <span>{today.location}</span></span>
              </p>
              <span class="eotd-cta">Explore this example <span aria-hidden="true">&rarr;</span></span>
            </div>
          </a>
        </div>
      </section>
    )}

    <!-- FIELD GUIDE -->
    <section class="block reveal">
      <div class="container carousel-head">
        <p class="overline">Field Guide</p>
        <h2>Your Biomimicry Field Guide</h2>
      </div>
      <div class="carousel">
        {GUIDES.map((g) => (
          <a class="tall-card guide" href={g.href}>
            <img src={g.img} alt="" loading="lazy" decoding="async" />
            <div class="tall-shade"></div>
            <span class="guide-tag">{g.tag}</span>
            <div class="tall-copy">
              <p class="tall-over guide-over">{g.sub}</p>
              <h3>{g.title}</h3>
              <span class="tall-link">Read guide <span aria-hidden="true">&rarr;</span></span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- CLOSING CTA -->
    <section class="closing reveal">
      <div class="container closing-grid">
        <div>
          <p class="overline closing-over">For R&amp;D and product teams</p>
          <h2>Find the problems worth solving in your own products</h2>
          <p class="closing-sub">The Biomimicry Opportunity Map scans your company website and suggests nature-inspired challenges for each product line.</p>
        </div>
        <div class="closing-actions">
          <a class="closing-btn" href={CTA.opportunityMap.href}>Map my opportunities</a>
          <a class="closing-link" href={CTA.fieldGuide.href}>Or start with the free Field Guide &rarr;</a>
        </div>
      </div>
    </section>
  </main>
</Base>

<script>
  import { particleBanner } from "../scripts/particles.js";

  const FIRST = 9;
  const state = { pill: "", q: "", levels: new Set(), industry: "", country: "", expanded: false };
  const cards = [...document.querySelectorAll("[data-grid] .ex-card")];
  const qInputs = [...document.querySelectorAll("[data-q]")];
  const clearBtns = [...document.querySelectorAll("[data-clear]")];
  const moreBtn = document.querySelector("[data-more]");
  const lessBtn = document.querySelector("[data-less]");

  function matches(c) {
    const d = c.dataset;
    if (state.pill) {
      const [k, v] = state.pill.split(":");
      if (k === "interest" && d.interest !== v) return false;
      if (k === "type" && d.type !== v) return false;
    }
    if (state.q && !d.search.includes(state.q)) return false;
    if (state.levels.size && ![...state.levels].some((l) => d.levels.split(" ").includes(l))) return false;
    if (state.industry && d.industry !== state.industry) return false;
    if (state.country && d.country !== state.country) return false;
    return true;
  }

  function render(animateFrom = Infinity) {
    let n = 0;
    for (const c of cards) {
      const ok = matches(c);
      const show = ok && (state.expanded || n < FIRST);
      if (ok) n++;
      const wasHidden = c.hidden;
      c.hidden = !show;
      c.classList.toggle("is-new", show && wasHidden && n > animateFrom);
    }
    document.querySelectorAll("[data-count]").forEach((el) => (el.textContent = String(n)));
    document.querySelector("[data-more-count]").textContent = String(n);
    document.querySelector("[data-empty]").hidden = n > 0;
    moreBtn.hidden = state.expanded || n <= FIRST;
    lessBtn.hidden = !state.expanded || n <= FIRST;
    const filtered = state.pill || state.q || state.levels.size || state.industry || state.country;
    const narrow = state.q || state.levels.size || state.industry || state.country;
    clearBtns.forEach((b) => (b.hidden = !filtered));
    document.querySelectorAll(".filter-toggle").forEach((t) => {
      t.classList.toggle("has-filters", !!narrow);
      t.querySelector(".ft-dot").hidden = !narrow;
      t.querySelector(".ft-chev").style.display = narrow ? "none" : "";
    });
    const pillBtn = document.querySelector(`[data-pill="${state.pill}"]`);
    const label = state.pill ? pillBtn.textContent.trim() : "";
    document.querySelector("[data-best-label]").textContent = label ? `${label} Examples` : "Best Examples";
    document.querySelector("[data-best-title]").textContent = label ? `The Best ${label} Examples` : "The Best Biomimicry Examples";
    document.querySelector("[data-best-lede]").hidden = !!label;
  }

  // Pills (hero and sticky stay in sync)
  document.querySelectorAll("[data-pill]").forEach((b) => b.addEventListener("click", () => {
    state.pill = b.dataset.pill;
    document.querySelectorAll("[data-pill]").forEach((x) => x.classList.toggle("is-active", x.dataset.pill === state.pill));
    state.expanded = false;
    render();
  }));

  // Filter panel open / close
  const panel = document.querySelector("[data-filter-panel]");
  const stickySearch = document.querySelector("[data-sticky-search]");
  document.querySelectorAll("[data-filter-toggle]").forEach((t) => t.addEventListener("click", (ev) => {
    const inSticky = !!t.closest("[data-sticky-cats]");
    const target = inSticky ? stickySearch : panel;
    const open = !target.classList.contains("is-open");
    target.classList.toggle("is-open", open);
    t.classList.toggle("is-open", open);
    t.setAttribute("aria-expanded", String(open));
    if (open) setTimeout(() => target.querySelector("input")?.focus(), 250);
    ev.stopPropagation();
  }));
  document.addEventListener("mousedown", (ev) => {
    for (const [box, root] of [[panel, document.querySelector(".hero")], [stickySearch, document.querySelector("[data-sticky-cats]")]]) {
      if (box.classList.contains("is-open") && !root.contains(ev.target)) {
        box.classList.remove("is-open");
        root.querySelectorAll("[data-filter-toggle]").forEach((t) => { t.classList.remove("is-open"); t.setAttribute("aria-expanded", "false"); });
      }
    }
  });

  qInputs.forEach((inp) => inp.addEventListener("input", () => {
    state.q = inp.value.trim().toLowerCase();
    qInputs.forEach((o) => { if (o !== inp) o.value = inp.value; });
    render();
  }));
  document.querySelectorAll("[data-level]").forEach((b) => b.addEventListener("click", () => {
    const l = b.dataset.level;
    state.levels.has(l) ? state.levels.delete(l) : state.levels.add(l);
    b.classList.toggle("is-active", state.levels.has(l));
    render();
  }));
  document.querySelectorAll("[data-sel]").forEach((s) => s.addEventListener("change", () => { state[s.dataset.sel] = s.value; render(); }));
  clearBtns.forEach((b) => b.addEventListener("click", () => {
    Object.assign(state, { pill: "", q: "", industry: "", country: "", expanded: false });
    state.levels.clear();
    qInputs.forEach((i) => (i.value = ""));
    document.querySelectorAll("[data-sel]").forEach((s) => (s.value = ""));
    document.querySelectorAll("[data-level]").forEach((b) => b.classList.remove("is-active"));
    document.querySelectorAll("[data-pill]").forEach((x) => x.classList.toggle("is-active", x.dataset.pill === ""));
    render();
  }));
  moreBtn.addEventListener("click", () => { state.expanded = true; render(FIRST); });
  lessBtn.addEventListener("click", () => { state.expanded = false; render(); document.getElementById("best").scrollIntoView({ behavior: "smooth" }); });

  // Read filters from a shared link (?interest=, ?industry=, ?country=, ?level=, ?q=)
  const p = new URLSearchParams(location.search);
  if (p.get("q")) { state.q = p.get("q").toLowerCase(); qInputs.forEach((i) => (i.value = p.get("q"))); }
  for (const k of ["industry", "country"]) if (p.get(k)) { state[k] = p.get(k); const s = document.querySelector(`[data-sel="${k}"]`); if (s) s.value = p.get(k); }
  p.getAll("level").forEach((l) => { state.levels.add(l); document.querySelector(`[data-level="${l}"]`)?.classList.add("is-active"); });
  if (p.get("interest")) { state.pill = `interest:${p.get("interest")}`; }
  if (state.q || state.levels.size || state.industry || state.country) { panel.classList.add("is-open"); document.querySelector(".hero [data-filter-toggle]").classList.add("is-open"); }
  render();

  // Sticky bars (Explora behaviour: categories bar after the hero, levels bar inside the levels section)
  const cats = document.querySelector("[data-sticky-cats]");
  const lvls = document.querySelector("[data-sticky-levels]");
  const sentinel = document.querySelector("[data-hero-sentinel]");
  const levelsSection = document.querySelector("[data-levels-section]");
  let pastHero = false, inLevels = false;
  const sync = () => {
    cats.classList.toggle("is-on", pastHero && !inLevels);
    lvls.classList.toggle("is-on", inLevels);
  };
  new IntersectionObserver(([e]) => { pastHero = !e.isIntersecting && e.boundingClientRect.top < 64; sync(); }, { rootMargin: "-64px 0px 0px 0px" }).observe(sentinel);
  const onScroll = () => {
    const r = levelsSection.getBoundingClientRect();
    inLevels = r.top < 64 && r.bottom > 160;
    sync();
  };
  window.addEventListener("scroll", onScroll, { passive: true });
  onScroll();

  // Level tabs and particle banner
  const banner = document.querySelector("[data-banner]");
  const cfg = JSON.parse(banner.dataset.config);
  const pb = particleBanner(banner.querySelector("[data-particles]"), { src: cfg.Form.img, color: cfg.Form.color });
  function setLevel(l) {
    document.querySelectorAll("[data-level-tab]").forEach((b) => {
      const on = b.dataset.levelTab === l;
      b.classList.toggle("is-active", on);
      if (b.hasAttribute("aria-selected")) b.setAttribute("aria-selected", String(on));
    });
    document.querySelectorAll("[data-level-copy]").forEach((el) => (el.hidden = el.dataset.levelCopy !== l));
    document.querySelectorAll("[data-level-grid]").forEach((g) => {
      const on = g.dataset.levelGrid === l;
      g.hidden = !on;
      if (on) g.querySelectorAll(".ex-card").forEach((c, i) => { c.classList.remove("is-new"); void c.offsetWidth; c.style.animationDelay = `${i * 60}ms`; c.classList.add("is-new"); });
    });
    banner.dataset.level = l;
    pb.set(cfg[l].img, cfg[l].color);
  }
  document.querySelectorAll("[data-level-tab]").forEach((b) => b.addEventListener("click", () => setLevel(b.dataset.levelTab)));

  // Example of the Day, chosen by today's date in the visitor's browser
  const eotd = document.querySelector("[data-eotd]");
  if (eotd) {
    const pool = JSON.parse(eotd.dataset.pool);
    const d = pool[Math.floor(Date.now() / 86400000) % pool.length];
    if (d) {
      eotd.href = `/${d.slug}/`;
      const set = (sel, val) => { const el = eotd.querySelector(sel); if (!el) return; el.hidden = !val; const t = el.querySelector("span") || el; if (val) t.textContent = val; };
      eotd.querySelector("[data-eotd-img1]").src = d.image;
      eotd.querySelector("[data-eotd-img2]").src = d.image2;
      set("[data-eotd-title]", d.title); set("[data-eotd-summary]", d.summary); set("[data-eotd-organism]", d.organism);
      set("[data-eotd-interest]", d.interest); set("[data-eotd-fn]", d.fn); set("[data-eotd-company]", d.company); set("[data-eotd-location]", d.location);
    }
  }
</script>

